// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "proxy": "",
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Zed (Default)",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet-latest",
    },
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Rosé Pine",
  },
  "theme_overrides": {
    "Rosé Pine": {
      // ===== サイドバーのファイルツリー =====
      "text.muted": "#e0def4",

      // ===== シンタックスカラー  =====
      "syntax": {
        // --- Strings & Literals ---
        "string": {
          "color": "#EBCBB5FF",
        },
        // --- Numbers & Constants ---
        "number": {
          "color": "#c4a7e7",
        },
        "boolean": {
          "color": "#c4a7e7",
        },
        "constant": {
          "color": "#c4a7e7",
        },
        // --- Keywords & Operators ---
        "keyword": {
          "color": "#4AB8E5FF",
        },
        "operator": {
          "color": "#9ccfd8",
        },
        // --- Functions & Methods ---
        "function": {
          "color": "#9ccfd8",
        },
        "constructor": {
          "color": "#9ccfd8",
        },
        "attribute": {
          "color": "#9ccfd8",
        },
        // --- Variables & Properties ---
        "variable": {
          "color": "#efefef",
        },
        // --- Punctuation ---
        "punctuation.bracket": {
          "color": "#EA9A97FF",
        },
        // --- Markup & Tags ---
        "tag": {
          "color": "#4AB8E5FF",
        },
      },
    },
  },
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "buffer_font_family": "Hack Nerd Font",
  "relative_line_numbers": "enabled",
  "soft_wrap": "editor_width",
  "terminal": {
    "env": {
      "EDITOR": "zed --wait",
    },
    "copy_on_select": true,
  },
  "inlay_hints": {
    // "enabled": true,
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true,
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },
}
