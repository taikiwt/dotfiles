tap "asmvik/formulae", "https://github.com/asmvik/homebrew-formulae.git"
# BLAKE2 b2sum reference binary
brew "b2sum"
# Console Matrix
brew "cmatrix"
# Perl lib for reading and writing EXIF metadata
brew "exiftool"
# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# Distributed revision control system
brew "git"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# User-friendly cURL replacement (command-line HTTP client)
brew "httpie"
# Sophisticated file transfer program
brew "lftp"
# Asynchronous event library
brew "libevent"
# Polyglot runtime manager (asdf rust clone)
brew "mise"
# PDF rendering library (based on the xpdf-3.0 code base)
brew "poppler"
# Object-relational database system
brew "postgresql@15"
# Wraps rm to prevent dangerous deletion of files
brew "safe-rm"
# 7-Zip is a file archiver with a high compression ratio
brew "sevenzip"
# Organize software neatly under a single directory tree (e.g. /usr/local)
brew "stow"
# Official tldr client written in Rust
brew "tlrc"
# Terminal multiplexer
brew "tmux"
# NetBSD's FTP client
brew "tnftp"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Extraction utility for .zip compressed archives
brew "unzip"
# Agent orchestration platform
cask "antigravity"
# Application uninstaller
cask "appcleaner", args: { appdir: "/Applications" }
# Tool to flash OS images to SD cards & USB drives
cask "balenaetcher"
# Tool to customise input devices and automate computer systems
cask "bettertouchtool"
# Web browser focusing on privacy
cask "brave-browser"
# Automated testing of webapps for Google Chrome
cask "chromedriver", args: { appdir: "/Applications" }
# Ghostty-based terminal with vertical tabs and notifications for AI coding agents
cask "cmux"
# Write, edit, and chat about your code with AI
cask "cursor", args: { appdir: "/Applications" }
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Collaborative team software
cask "figma"
# Web browser
cask "firefox", args: { appdir: "/Applications" }
# Privacy-focused Firefox-based browser
cask "floorp"
# Download manager with a torrent client
cask "folx"
cask "font-hack-nerd-font", args: { appdir: "/Applications" }
cask "font-hackgen-nerd"
cask "font-noto-sans-jp", args: { appdir: "/Applications" }
cask "font-symbols-only-nerd-font"
# Audio player
cask "foobar2000"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Web browser
cask "google-chrome", args: { appdir: "/Applications" }
# Web browser
cask "google-chrome@canary"
# Native desktop AI assistant from Google
cask "google-gemini"
# Keyboard customiser
cask "karabiner-elements"
# Web browser
cask "librewolf"
# Open-source cross-platform alternative to AirDrop
cask "localsend"
# Clipboard manager
cask "maccy"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian", args: { appdir: "/Applications" }
# Replacement for Docker Desktop
cask "orbstack"
# HTTP debugging proxy
cask "proxyman", args: { appdir: "/Applications" }
# Control your tools with a few keystrokes
cask "raycast"
# Unpacks archive files
cask "the-unarchiver", args: { appdir: "/Applications" }
# Virtual machines UI using QEMU
cask "utm"
# Open-source code editor
cask "visual-studio-code", args: { appdir: "/Applications" }
# Web browser with built-in email client focusing on customization and control
cask "vivaldi"
# Multimedia player
cask "vlc", args: { appdir: "/Applications" }
# Rust-based terminal
cask "warp", args: { appdir: "/Applications" }
# Multiplayer code editor
cask "zed"
# Gecko based web browser
cask "zen"
npm "corepack"
